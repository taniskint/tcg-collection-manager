            <li><a href="collections.html"><p>Collections</p></a></li>
            <li><a href="decks.html"><p>Decks</p></a></li>
            <li><a href="account.html"><p>Account</p></a></li>
        </ul>
    </nav>

    <main>
        <div class="set-chiclet"><p>Black Bolt & White Flare</p></div>
        <div class="set-chiclet"><p>Destined Rivals</p></div>
        <div class="set-chiclet"><p>Journey Together</p></div>
        <div class="set-chiclet"><p>Prismatic Evolutions</p></div>
        <div class="set-chiclet"><p>Stellar Crown</p></div>
        <div class="set-chiclet"><p>Shrouded Fable</p></div>
        <div class="set-chiclet"><p>Twilight Masquerade</p></div>
        <div class="set-chiclet"><p>Temporal Forces</p></div>
        <div class="set-chiclet"><p>Paldean Fates</p></div>
        <div class="set-chiclet"><p>Paradox Rift</p></div>
