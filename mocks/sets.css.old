main {
    display: flex;
    flex-flow: row wrap;
    justify-content: center;
    gap: 16px;
}

.set-chiclet {
    width: 200px;
    height: 40px;
    border: 1px solid var(--shade);
    border-radius: 4px;
    padding: 8px;
    transition: box-shadow 0.1s linear;
    display: flex;
    flex-flow: column nowrap;
    justify-content: center;
    align-items: center;
}

.set-chiclet:hover {
    box-shadow: 0 0 8px var(--shade);
}

.img-container {
    flex: 1;
}

img {
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    flex: auto;
}

.game-name {
    padding-top: 8px;
}
