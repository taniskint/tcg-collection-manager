<!DOCTYPE html>
<html>
<head>
    <title>Games</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="styles.css">
    <link rel="stylesheet" href="games.css">
</head>
<body>
    <nav>
        <div class="nav-header">
            <a href="index.html"><p>TCG Collection Manager</p></a>
	        <div id="show-links" class="show-links">+</div>
        </div>
        <ul hidden id="nav-links" class="nav-links">
            <li><a href="games.html"><p>Games</p></a></li>
            <li><a href="collections.html"><p>Collections</p></a></li>
            <li><a href="decks.html"><p>Decks</p></a></li>
            <li><a href="account.html"><p>Account</p></a></li>
        </ul>
    </nav>

    <main>
        <a href="sets.html?game=ptcg">
            <div class="game-chiclet">
                <img src="ptcg-logo.svg" alt="The Pokemon Trading Card Game logo.">
                <p class="game-name">Pokemon TCG</p>
            </div>
        </a>
        <div class="game-chiclet">
            <img src="riftbound-logo.svg" alt="The Riftbound logo.">
            <p class="game-name">Riftbound</p>
        </div>
        <div class="game-chiclet">
            <img src="altered-logo.png" alt="The Altered logo.">
            <p class="game-name">Altered</p>
        </div>
        <div class="game-chiclet">
            <img src="mtg-logo.png" alt="The Magic: The Gathering logo.">
            <p>Magic: The Gathering</p>
        </div>
        <div class="game-chiclet"></div>
        <div class="game-chiclet"></div>
        <div class="game-chiclet"></div>
        <div class="game-chiclet"></div>
        <div class="game-chiclet"></div>
        <div class="game-chiclet"></div>
        <div class="game-chiclet"></div>
        <div class="game-chiclet"></div>
        <div class="game-chiclet"></div>
        <div class="game-chiclet"></div>
        <div class="game-chiclet"></div>
    </main>

    <script>
        const showLinksDiv = document.getElementById("show-links");
        const navLinksUL = document.getElementById("nav-links");

        showLinksDiv.addEventListener("click", () => {
            navLinksUL.hidden = !navLinksUL.hidden;
        });
    </script>
</body>
</html>
